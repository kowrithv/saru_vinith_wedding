# Vorlage: cp .env.example .env.local (lokal) bzw. .env.production (Server)
ADMIN_PASSWORD=
# Optional - wird sonst automatisch erzeugt und in der DB gespeichert
ADMIN_SECRET=
# Gäste-Kennwort für Galerie, Gästebuch, Erinnerungen und Foto-Upload: kurz und
# merkbar, am besten nur Buchstaben und Ziffern (Groß-/Kleinschreibung egal),
# aber nicht erratbar: keine Namen, kein Datum, kein Ort.
# Es steht im QR-Link /gallery#k=<Kennwort> (README, "Gäste-Zugang").
GUEST_PASSWORD=
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_PUBLIC_BASE_URL=
# Optional - nur wenn der Bucket mit EU-Jurisdiktion angelegt wurde: eu
# (der S3-Endpoint lautet dann <ACCOUNT_ID>.eu.r2.cloudflarestorage.com)
R2_JURISDICTION=
# Nur für lokale Tests mit einem Ersatz-Server statt R2 (siehe README); in Produktion leer lassen.
# R2_ENDPOINT=http://127.0.0.1:3199
# Optional - Quelle der Client-IP für die Rate-Limiter. Standard: x-forwarded-for
# (der Reverse-Proxy, Caddy, setzt ihn). cf-connecting-ip nur, wenn die Website hinter dem
# Cloudflare-Proxy (orange Wolke) läuft - sonst kann jeder den Header fälschen.
CLIENT_IP_HEADER=
# Optional - Cache-Purge beim Löschen wird ohne diese Werte einfach übersprungen
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ZONE_ID=
# Optional - E-Mail-Alarme (Backup fehlgeschlagen, Platte voll, Start-Meldung).
# Ohne SMTP_HOST, SMTP_FROM und ALERT_EMAIL_TO wird nur ins Log geschrieben.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
ALERT_EMAIL_TO=
