# Vorlage fuer die Umgebungsvariablen der Website.
#   lokal (npm run dev):       cp .env.example .env.local
#   Server (docker compose):   cp .env.example .env.production
# Die Kopie danach mit den echten Werten fuellen. Sie wird NIE ins Git-Repo
# eingecheckt und landet auch nicht im Docker-Image.

# --- Admin-Bereich (/admin) -------------------------------------------------
# Passwort fuer den Login im Admin-Bereich
ADMIN_PASSWORD=SaruVinith2026!
# Zufaelliger Wert zum Signieren des Admin-Cookies, z. B. erzeugen mit:
#   openssl rand -hex 32
ADMIN_SECRET=

# --- Foto-Uploads (Galerie & Erinnerungen) ----------------------------------
# Kennwort, das die Gaeste zum Hochladen brauchen
UPLOAD_PASSWORD_EMPFANG=Empfang2026

# --- Google Drive Sync (optional) -------------------------------------------
# Ohne diese Werte werden Uploads nur lokal gespeichert.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REFRESH_TOKEN=
GOOGLE_DRIVE_GALLERY_FOLDER_ID=
GOOGLE_DRIVE_MEMORIES_FOLDER_ID=
